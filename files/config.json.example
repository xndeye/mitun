{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "system"
      },
      {
        "type": "tls",
        "tag": "bootstrap",
        "server": "223.5.5.5",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      {
        "type": "https",
        "tag": "domestic",
        "server": "dns.alidns.com",
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        },
        "domain_resolver": "bootstrap"
      },
      {
        "type": "https",
        "tag": "cloudflare",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "domain_resolver": "bootstrap",
        "detour": "🌐 Select Proxy"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/16",
        "inet6_range": "2001:2::/49"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "bootstrap"
      },
      {
        "clash_mode": "Global",
        "server": "cloudflare"
      },
      {
        "query_type": ["AAAA"],
        "action": "reject"
      },
      {
        "rule_set": ["reject"],
        "action": "reject"
      },
      {
        "rule_set": [
          "lan",
          "direct",
          "steam-cn",
          "apple-cn",
          "microsoft-cn",
          "fake-ip-filter"
        ],
        "action": "route",
        "server": "domestic"
      },
      {
        "action": "route",
        "server": "fakeip",
        "rewrite_ttl": 10
      }
    ],
    "final": "domestic",
    "strategy": "prefer_ipv4",
    "cache_capacity": 4096,
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "direct",
      "detour": "➡️ Direct"
    },
    {
      "tag": "proxy",
      "detour": "🌐 Select Proxy"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box",
      "address": ["198.19.0.0/16", "2001:2:0:8000::/64"],
      "mtu": 9000,
      "stack": "system",
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": true,
      "route_exclude_address": [
        "10.0.0.0/8",
        "169.254.0.0/16",
        "172.16.0.0/12",
        "192.0.0.0/24",
        "192.0.2.0/24",
        "192.168.0.0/16",
        "224.0.0.0/3",
        "fd00::/8",
        "fe80::/10",
        "ff00::/8"
      ],
      "endpoint_independent_nat": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🌐 Select Proxy",
      "outbounds": [
        "⚡ Auto Proxy",
        "➡️ Direct"
      ],
      "default": "⚡ Auto Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "⚡ Auto Proxy",
      "outbounds": [
      ],
      "url": "https://www.apple.com/library/test/success.html",
      "interval": "30m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "🧭 Fallback",
      "outbounds": ["➡️ Direct", "🌐 Select Proxy", "⚡ Auto Proxy"],
      "default": "🌐 Select Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "➡️ Direct"
    }
  ],
  "route": {
    "default_http_client": "direct",
    "rules": [
      {
        "action": "sniff",
        "sniffer": ["tls", "http", "quic"],
        "timeout": "300ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [{ "protocol": "dns" }, { "port": 53 }],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "➡️ Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "🌐 Select Proxy"
      },
      {
        "rule_set": ["reject"],
        "action": "reject"
      },
      {
        "rule_set": ["lan"],
        "action": "route",
        "outbound": "➡️ Direct"
      },
      {
        "rule_set": ["direct", "steam-cn", "apple-cn", "microsoft-cn"],
        "action": "route",
        "outbound": "➡️ Direct"
      },
      {
        "rule_set": ["ai", "proxy"],
        "action": "route",
        "outbound": "🌐 Select Proxy"
      },
      {
        "rule_set": ["lan-ip"],
        "action": "reject",
        "outbound": "➡️ Direct"
      },
      {
        "rule_set": ["reject-ip"],
        "action": "reject",
        "outbound": "➡️ Direct"
      },
      {
        "rule_set": ["direct-ip"],
        "action": "route",
        "outbound": "➡️ Direct"
      },
      {
        "rule_set": ["proxy-ip"],
        "action": "route",
        "outbound": "🌐 Select Proxy"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "fake-ip-filter",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/fakeip-filter.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "lan",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/lan.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "reject",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/reject.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "reject-ip",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/reject@ip.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "steam-cn",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/steam@cn.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "microsoft-cn",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/microsoft@cn.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "apple-cn",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/apple@cn.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "ai",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/ai.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "proxy",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/proxy.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "proxy-ip",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/proxy@ip.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "direct",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/direct.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "direct-ip",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/direct@ip.srs",
        "update_interval": "12h"
      },
      {
        "type": "remote",
        "tag": "lan-ip",
        "format": "binary",
        "url": "https://gh-proxy.org/https://raw.githubusercontent.com/xndeye/rule-merger/release/lan@ip.srs",
        "update_interval": "12h"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "domestic",
    "final": "🧭 Fallback"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://gh-proxy.org/https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "secret": "mihomo",
      "default_mode": "Rule",
      "access_control_allow_private_network": true
    }
  }
}
