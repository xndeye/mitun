# SELinux 策略文件 — KernelSU MiTun 模块
# 允许运行在 u:r:su:s0 上下文中的 mihomo 进程操作 TUN 设备及网络能力

# 允许 mihomo 进程对 TUN 字符设备执行读、写、ioctl、open 操作
# 这是 Mihomo 创建和使用 TUN 接口（Meta）所必需的
allow su tun_device chr_file { read write ioctl open };

# 授予 net_admin 和 net_raw 网络能力
# net_admin：创建 TUN 接口、修改路由表（auto-route）所必需
# net_raw：原始套接字操作所必需
allow su self capability { net_admin net_raw };

# 允许 su 上下文向内核请求 SELinux 策略计算（可选，用于 SELinux 策略查询）
allow su kernel security { compute_av };
